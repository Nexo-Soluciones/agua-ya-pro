datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 Int       @id @default(autoincrement())
  nombre             String
  telefono           String    @unique
  email              String?   @unique
  passwordHash       String?   // Para acceso administrativo
  pinHash            String?   // PIN de 4 dígitos hasheado con bcrypt para repartidores
  rol                String    @default("REPARTIDOR") // "ADMIN" | "REPARTIDOR"
  estado             String    @default("ACTIVO")     // "ACTIVO" | "INACTIVO"
  
  // GPS Location Fields for Real-Time Tracking
  lat                Float?
  lng                Float?
  speed              Float?
  heading            Float?
  lastLocationUpdate DateTime?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  pedidosAsignados   Order[]       @relation("DriverOrders")
  deliveryLogs       DeliveryLog[]
  auditLogs          AuditLog[]
}

model Client {
  id             Int      @id @default(autoincrement())
  nombre         String
  telefono       String   @unique
  direccion      String
  barrioSector   String?
  tipoCliente    String   @default("VIEJO") // "VIEJO" | "NUEVO"
  precioAcordado Float?   @default(7000)
  notasUbicacion String?
  requiereFactura Boolean @default(false)
  numeroFactura   String?
  lat            Float?
  lng            Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  pedidos Order[]

  @@index([nombre])
  @@index([direccion])
}

model Order {
  id                 Int       @id @default(autoincrement())
  numeroPedido       Int?
  clienteId          Int
  cliente            Client    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  repartidorId       Int?
  repartidor         User?     @relation("DriverOrders", fields: [repartidorId], references: [id], onDelete: SetNull)
  
  cantidadBotellones Int       @default(1)
  precioUnitario     Float     @default(7000)
  montoTotal         Float     @default(7000)
  resumenProductos   String?   // Ej. "2x Botellón, 1x Bandeja 620 ML"
  
  metodoPago         String    @default("EFECTIVO") // "EFECTIVO" | "NEQUI" | "TRANSFERENCIA" | "CREDITO"
  estadoPago         String    @default("PENDIENTE") // "PENDIENTE" | "VERIFICADO" | "RECHAZADO"
  estadoEntrega      String    @default("PENDIENTE") // "PENDIENTE" | "EN_CAMINO" | "ENTREGADO" | "CANCELADO"
  comprobanteRef     String?
  numeroRemision     String?
  numeroFactura      String?
  creadoPor          String?   // Nombre del usuario/operador administrativo que creó o gestionó el pedido
  
  fechaCreacion      DateTime  @default(now())
  fechaEntrega       DateTime?
  updatedAt          DateTime  @updatedAt

  items              OrderItem[]
  logs               DeliveryLog[]

  @@index([estadoEntrega])
  @@index([repartidorId])
  @@index([fechaCreacion])
  @@index([estadoPago])
  @@index([clienteId])
}

model Product {
  id                 Int       @id @default(autoincrement())
  nombre             String    @unique
  categoria          String    // "BOTELLONES" | "BANDEJAS" | "DISPENSADORES" | "GARRAFAS" | "PAQUETES" | "ESPECIAL"
  precioBase         Float
  preciosDisponibles String?   // JSON array de precios: "[10000, 9500, 9000, 8500, 8000, 10500]"
  icono              String?   // Icono o emoji representativo
  descripcion        String?
  estado             String    @default("ACTIVO") // "ACTIVO" | "INACTIVO"
  orden              Int       @default(0)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  orderItems         OrderItem[]
}

model OrderItem {
  id             Int      @id @default(autoincrement())
  pedidoId       Int
  pedido         Order    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId     Int?
  producto       Product? @relation(fields: [productoId], references: [id], onDelete: SetNull)
  
  nombreProducto String
  cantidad       Int      @default(1)
  precioUnitario Float
  subtotal       Float

  @@index([pedidoId])
}

model DeliveryLog {
  id           Int      @id @default(autoincrement())
  pedidoId     Int
  pedido       Order    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  repartidorId Int
  repartidor   User     @relation(fields: [repartidorId], references: [id], onDelete: Cascade)
  horaMarcado  DateTime @default(now())
  estadoNuevo  String
  notasEntrega String?

  @@index([pedidoId])
  @@index([repartidorId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  usuarioId Int?
  rol       String
  accion    String
  detalles  String?
  ipAddress String?
  createdAt DateTime @default(now())

  usuario   User?    @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}


